# watsonx Orchestrate connection config for the IRS AI Risk local MCP toolkit.
#
# Copy to .env and fill in your values, then:
#   set -a; source deploy/ibm/local-mcp-toolkit/.env; set +a
#
# The API key is intentionally NOT stored here — pass it at runtime via
# WXO_API_KEY or let the register script prompt for it (hidden input).

# Name of the Orchestrate ADK environment (must already exist: `orchestrate env list`).
WXO_ENV_NAME=gsa-hackathon

# Your watsonx Orchestrate SaaS instance URL.
WXO_INSTANCE_URL=https://api.ca-tor.watson-orchestrate.cloud.ibm.com/instances/19be3de1-4b35-40f5-9300-84dfb31f66eb

# Toolkit name to register under. Must be unique. The 'mdc-' prefix identifies
# your participant slot; do not change it after first registration.
TOOLKIT_NAME=mdc-irs-risk-toolkit

# Python interpreter to use when verifying the staging directory locally.
# Orchestrate's runtime provides its own Python; this is for local validation only.
LOCAL_PYTHON=python3.12

# --- API key (NOT stored here) -----------------------------------------------
# Set at runtime:
#   export WXO_API_KEY="<your ibm cloud api key>"
# If unset, the register script prompts for it (input hidden).
