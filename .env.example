# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Bob, Claude Desktop, Claude Code)
# "streamable-http" — remote HTTP server (IBM Code Engine, cloud.gov)
# On cloud platforms, PORT is injected automatically — leave this as stdio.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Risk Engine ──────────────────────────────────────────────────────────────
# Bump RISK_ENGINE_VERSION whenever weights or thresholds change.
# RISK_ENGINE_VERSION=hypothetical-v1

# ─── External Data ────────────────────────────────────────────────────────────
# IRS SOI Socrata endpoint (public, no key required).
# IRS_SOI_BASE_URL=https://data.irs.gov/resource
# HTTP_TIMEOUT=15.0
